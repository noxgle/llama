# Qwen2.5-VL-3B Q4_K_M - Vision (image-text-to-text)
# Model: unsloth/Qwen2.5-VL-3B-Instruct-GGUF:20ce64893974f3faa729fe3dbdd70f8cabc2523c
# Pliki:
#   Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf ~1.93 GB (1929901408)
#   mmproj-F16.gguf ~1.34 GB (1338428256)  — BF16/F32 tez dostepne
# Pobieranie na dev .38:
#   curl -L -o /opt/llama/models/qwen2.5-vl-3b-q4_k_m.gguf \
#     https://huggingface.co/unsloth/Qwen2.5-VL-3B-Instruct-GGUF/resolve/20ce64893974f3faa729fe3dbdd70f8cabc2523c/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
#   curl -L -o /opt/llama/models/mmproj-qwen2.5-vl-3b-f16.gguf \
#     https://huggingface.co/unsloth/Qwen2.5-VL-3B-Instruct-GGUF/resolve/20ce64893974f3faa729fe3dbdd70f8cabc2523c/mmproj-F16.gguf
# Weryfikacja: head -c 4 /models/qwen2.5-vl-3b-q4_k_m.gguf | od -A x -t x1z  # -> 47 47 55 46 GGUF

# Model lokalny (HF get_hf_plan bug — uzyj -m, nie -hf)
MODEL_FLAG=-m
MODEL=/models/qwen2.5-vl-3b-q4_k_m.gguf

# Multimodal projector — osobne argi (b10213 odrzuca --mmproj=/path)
MMPROJ_FLAG=--mmproj
MMPROJ=/models/mmproj-qwen2.5-vl-3b-f16.gguf

# Server — jakosc: CTX 65K dla dlugich sesji, image 1024 dla grounding/OCR
PORT=8089
HOST=0.0.0.0
CTX=65536
N_PREDICT=-1
NGLAYERS=999
CPUMOE=exps=CPU
FLASHATTN=on

BATCH=2048
UBATCH=1024
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=0

CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM=4096
CACHE_REUSE=256
CTX_CHECKPOINTS=10

# Vision — jakosc: 1024/1024 dla grounding/OCR (warning Qwen-VL wymaga min 1024)
IMAGE_MIN_TOKENS=1024
IMAGE_MAX_TOKENS=1024
MTMD_BATCH_MAX_TOKENS=1024

# Qwen2.5-VL nie ma thinking tokens (vs Gemma/Qwen3)
REASONING=off

# Brak MTP draft dla 3B
SPEC_TYPE=none
