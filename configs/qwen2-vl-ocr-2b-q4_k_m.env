# Qwen2-VL-OCR-2B Q4_K_M - Vision OCR (finetune)
# Model: mradermacher/Qwen2-VL-OCR-2B-Instruct-GGUF:8814b608 (mirror prithivMLmods/Qwen2-VL-OCR-2B-Instruct)
# Pliki:
#   Qwen2-VL-OCR-2B-Instruct.Q4_K_M.gguf ~986 MB (986046880)
#   Qwen2-VL-OCR-2B-Instruct.mmproj-fp16.gguf ~1.27 GB (1331656192)
# Alternatywa prithivMLmods/Qwen2-VL-OCR-2B-Instruct-GGUF — brak mmproj (same wagi, hash Q4_K_M identyczny)
# Pobieranie na dev .38:
#   curl -L -o /opt/llama/models/qwen2-vl-ocr-2b-q4_k_m.gguf \
#     https://huggingface.co/mradermacher/Qwen2-VL-OCR-2B-Instruct-GGUF/resolve/main/Qwen2-VL-OCR-2B-Instruct.Q4_K_M.gguf
#   curl -L -o /opt/llama/models/mmproj-qwen2-vl-ocr-2b-f16.gguf \
#     https://huggingface.co/mradermacher/Qwen2-VL-OCR-2B-Instruct-GGUF/resolve/main/Qwen2-VL-OCR-2B-Instruct.mmproj-fp16.gguf
# Weryfikacja: head -c 4 /models/qwen2-vl-ocr-2b-q4_k_m.gguf | od -A x -t x1z  # -> 47 47 55 46 GGUF

# Model lokalny (HF get_hf_plan bug — uzyj -m)
MODEL_FLAG=-m
MODEL=/models/qwen2-vl-ocr-2b-q4_k_m.gguf

# Multimodal projector — osobne argi (b10213 odrzuca --mmproj=/path)
MMPROJ_FLAG=--mmproj
MMPROJ=/models/mmproj-qwen2-vl-ocr-2b-f16.gguf

# Server — OCR: CTX 16K, image 1024 dla jakosci
PORT=8089
HOST=0.0.0.0
CTX=16384
N_PREDICT=-1
NGLAYERS=999
CPUMOE=exps=CPU
FLASHATTN=on

BATCH=1024
UBATCH=512
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=0

CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM=8192
CACHE_REUSE=256
CTX_CHECKPOINTS=4

# Vision — 1024/1024 wymagane dla Qwen-VL grounding/OCR
IMAGE_MIN_TOKENS=1024
IMAGE_MAX_TOKENS=1024
MTMD_BATCH_MAX_TOKENS=1024

# Brak thinking tokens
REASONING=off

# Brak MTP draft dla 2B
SPEC_TYPE=none
