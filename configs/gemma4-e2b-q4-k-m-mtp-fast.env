# Gemma 4 E2B (5.1B) - Q4_K_M + multimodal + MTP [FAST — niska latencja]
# Uzycie: petla kamera->opis->kamera->opis (brak historii miedzy klatkami)
# Priorytet: szybkosc kosztem szczegolowosci i dlugiej historii
# Docs: AGENTS.md "Deployment gotchas"

# Model lokalny (get_hf_plan bug)
MODEL_FLAG=-m
MODEL=/models/gemma-4-E2B-it-Q4_K_M.gguf

# Multimodal
MMPROJ_FLAG=--mmproj
MMPROJ=/models/mmproj-F16.gguf

# Image token limits — niskie dla szybkiego kodowania
IMAGE_MIN_TOKENS=66
IMAGE_MAX_TOKENS=256

# Wylaczone reasoning (thinking tokens) — brak opoznien
REASONING=off

# Server
PORT=8089
HOST=0.0.0.0

# Maly kontekst — brak historii miedzy obrazami
CTX=16384
N_PREDICT=-1

NGLAYERS=999
CPUMOE=exps=CPU
FLASHATTN=on

# Batch dla szybkiego prefillu
BATCH=2048
UBATCH=1024

THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM=512
CACHE_REUSE=256
CTX_CHECKPOINTS=2

# MTP — n_max=3 (E2B dense, nie MoE — overhead nizszy dec niz w AGENTS.md)
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_N_MIN=1
SPEC_DRAFT_P_MIN=0.75
DRAFT_FLAG=-md
DRAFT_MODEL=/models/mtp-gemma-4-E2B-it-Q8_0.gguf
GPU_LAYERS_DRAFT=99
