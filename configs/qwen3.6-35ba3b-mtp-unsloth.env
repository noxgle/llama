# Qwen3.6 35B-A3B MTP - Speculative decoding (upstream PR #22673)

# Target model (MTP head embedded in same GGUF)
# Pinned to commit 5bc3e23 (Dynamic 2.0) — unsloth removed the UD-Q4_K_M ref
# (2026-08): repo re-uploaded, new filename Qwen3.6-35B-A3B-UD-Q4_K_M.gguf.
MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF:5bc3e238d916f48a861bac2f8a1990a0e9b7e98d

# Server
PORT=8089
HOST=0.0.0.0

# Context (143K — q8_0/q8_0 KV cache needs ~93% VRAM, 160K causes OOM with MTP)
CTX=143360

# Disable server-side token cap
N_PREDICT=-1

# GPU layers - offload as many as possible, rest in RAM
NGLAYERS=999

# MoE experts on CPU (MoE model, most experts stay in RAM)
CPUMOE=exps=CPU

# Flash Attention
FLASHATTN=on

# Runtime
BATCH=3072
UBATCH=1536
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

# Memory
MMAP_FLAG=--no-mmap

# KV cache quantization
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# KV cache in system RAM (MB) — reduces VRAM pressure for long contexts
CACHE_RAM=4096

# KV cache reuse window (tokens) — reuse KV from recent requests
CACHE_REUSE=256

# KV context checkpoints (more = faster reprocessing, more RAM)
CTX_CHECKPOINTS=10

# Slot save/restore path (KV cache persistence via /slots/{id}/save|restore)
SLOT_SAVE_PATH=/slots

# MTP speculative decoding
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=1

# Thinking budget (reasoning tokens) — cap internal thinking at 2048 tokens;
# message injected before the end-of-thinking tag when budget is exhausted.
# Passed via LLAMA_ARG_THINK_BUDGET / LLAMA_ARG_THINK_BUDGET_MESSAGE (docker-compose).
REASONING_BUDGET=2048
# NOTE: no apostrophes, quotes required — llama.sh sources this file via bash
REASONING_BUDGET_MESSAGE="thinking budget exceeded, answer now."
