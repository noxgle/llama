# Tiel-Coder 35B-A3B MTP UD-Q5_K_XL - Speculative decoding (upstream PR #22673)
# Base: Ornith-1.5-35B-A3B (NOT Qwen3.6) — 256 experts, 8 active/token; requant with
# own imatrix + Sharp chat template baked into the GGUF. MTP head (trained, Q3_K)
# embedded in same file.
# NOTE: coding-tuned build; weaker at trivia/knowledge vs Qwen (MMLU-Pro 73.7).
# Author sampling: temp 1.0 (0.6 agentic coding), top_p 0.95, top_k 20 — benchmarks
# in this repo run with default sampling unless noted.
# Model file: Tiel-Coder-35B-A3B-MTP-UD-Q5_K_XL.gguf (~27 GB)
# Download: https://huggingface.co/peculiar-ragdoll/Tiel-Coder-35B-A3B-GGUF-MTP/resolve/main/Tiel-Coder-35B-A3B-MTP-UD-Q5_K_XL.gguf
# SHA256: 44df39d67c62edc2f084faa14ae456193977de50340ac1c3219202bcc8018616

# Target model (local GGUF file — download via curl, resume with curl -C -)
MODEL_FLAG=-m
MODEL=/models/tiel-coder-35b-a3b-mtp-ud-q5_k_xl.gguf

# Server
PORT=8089
HOST=0.0.0.0

# Context (120K — compromise between VRAM headroom and context size)
CTX=122880

# Disable server-side token cap
N_PREDICT=-1

# GPU layers - offload as many as possible, rest in RAM
NGLAYERS=999

# MoE experts on CPU (MoE model, most experts stay in RAM)
CPUMOE=exps=CPU

# Flash Attention
FLASHATTN=on

# Runtime
BATCH=3072
UBATCH=1536
# LXC has only 4 CPUs (verified 2026-06-26), see cpuset.cpus.effective
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

# Memory
MMAP_FLAG=--no-mmap

# KV cache quantization
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# KV cache in system RAM (MB) — reduces VRAM pressure for long contexts
CACHE_RAM=3072

# KV cache reuse window (tokens) — reuse KV from recent requests
CACHE_REUSE=256

# KV context checkpoints (more = faster reprocessing, more RAM)
CTX_CHECKPOINTS=8

# MTP speculative decoding
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=1

# Thinking budget (reasoning tokens) — cap internal thinking at 8192 tokens
# (coding workload needs longer reasoning; Q4 stays at 2048);
# message injected before the end-of-thinking tag when budget is exhausted.
# Passed via LLAMA_ARG_THINK_BUDGET / LLAMA_ARG_THINK_BUDGET_MESSAGE (docker-compose).
REASONING_BUDGET=8192
# NOTE: value must be double-quoted (spaces + apostrophes OK) — llama.sh sources this file via bash
REASONING_BUDGET_MESSAGE="thinking budget exceeded, answer now."
