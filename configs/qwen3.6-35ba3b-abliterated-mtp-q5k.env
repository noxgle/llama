# Huihui Qwen3.6 35B-A3B Abliterated MTP Q5_K - Speculative decoding (upstream PR #22673)
# Uncensored (abliterated) variant of Qwen3.6-35B-A3B; MTP head embedded in same GGUF.
# NOTE: upstream repo huihui-ai/Huihui-Qwen3.6-35B-A3B-abliterated-MTP-GGUF
# provides Q5_K (no Q5_K_M file exists there) — this config uses Q5_K.
# Model file: Huihui-Qwen3.6-35B-A3B-abliterated-ggml-model-Q5_K.gguf (~24 GB)
# Download: https://huggingface.co/huihui-ai/Huihui-Qwen3.6-35B-A3B-abliterated-MTP-GGUF/resolve/main/Huihui-Qwen3.6-35B-A3B-abliterated-ggml-model-Q5_K.gguf

# Target model (local GGUF file — download via curl, resume with curl -C -)
MODEL_FLAG=-m
MODEL=/models/huihui-qwen3.6-35b-a3b-abliterated-q5_k.gguf

# Server
PORT=8089
HOST=0.0.0.0

# Context (120K — compromise between VRAM headroom and context size)
CTX=122880

# Disable server-side token cap
N_PREDICT=-1

# GPU layers - offload as many as possible, rest in RAM
NGLAYERS=999

# MoE experts on CPU (MoE model, most experts stay in RAM)
CPUMOE=exps=CPU

# Flash Attention
FLASHATTN=on

# Runtime
BATCH=3072
UBATCH=1536
# LXC has only 4 CPUs (verified 2026-06-26), see cpuset.cpus.effective
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

# Memory
MMAP_FLAG=--no-mmap

# KV cache quantization
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# KV cache in system RAM (MB) — reduces VRAM pressure for long contexts
CACHE_RAM=3072

# KV cache reuse window (tokens) — reuse KV from recent requests
CACHE_REUSE=256

# KV context checkpoints (more = faster reprocessing, more RAM)
CTX_CHECKPOINTS=8

# MTP speculative decoding
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=1

# Thinking budget (reasoning tokens) — cap internal thinking at 8192 tokens
# (coding workload needs longer reasoning; Q4 stays at 2048);
# message injected before the end-of-thinking tag when budget is exhausted.
# Passed via LLAMA_ARG_THINK_BUDGET / LLAMA_ARG_THINK_BUDGET_MESSAGE (docker-compose).
REASONING_BUDGET=8192
# NOTE: value must be double-quoted (spaces + apostrophes OK) — llama.sh sources this file via bash
REASONING_BUDGET_MESSAGE="thinking budget exceeded, answer now."
