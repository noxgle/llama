# Gemma 4 E2B (2.3B eff / 5.1B total) - Q4_K_M + multimodal + MTP draft
# Main model: unsloth Q4_K_M (~3.4 GB, dense model, ~30+ tok/s expected)
# Multimodal: mmproj-F16 for image input (separate file, ~150 MB)
# Draft: MTP Q8_0 head (~462 MB, ~90% accept)
# Flags: MODEL=-hf (main), DRAFT_FLAG=-md, MMPROJ_FLAG=--mmproj (local files)
# Docs: see AGENTS.md "Deployment gotchas" section

# Main model — lokalny plik (get_hf_plan bug: even top-level files fail on this repo)
MODEL_FLAG=-m
MODEL=/models/gemma-4-E2B-it-Q4_K_M.gguf

# Multimodal projector (lokalny plik pobrany przez curl)
MMPROJ_FLAG=--mmproj
MMPROJ=/models/mmproj-F16.gguf

# Server
PORT=8089
HOST=0.0.0.0

# Context - 128K (mały model, KV cache zmieści się w RAM)
CTX=131072

# Disable server-side token cap
N_PREDICT=-1

# GPU layers - full offload (mały model ~3.4 GB, wszystko na GPU)
NGLAYERS=999

# MoE experts on CPU (safety — E2B jest dense, ale flag nie szkodzi)
CPUMOE=exps=CPU

# Flash Attention
FLASHATTN=on

# Batch sizes (1024 baseline — mały model, nie potrzebuje więcej)
BATCH=1024
UBATCH=1024

# CPU threads
THREADS=4
THREADS_BATCH=4
PARALLEL=1
POLL=50

# KV cache quantization
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# KV cache in system RAM (MB) — mały model, 1 GB wystarczy na start
CACHE_RAM=1024

# KV cache reuse window (tokens) — ignored for MTP but harmless
CACHE_REUSE=256

# KV context checkpoints
CTX_CHECKPOINTS=4

# MTP speculative decoding - draft-mtp
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=1
SPEC_DRAFT_N_MIN=1
SPEC_DRAFT_P_MIN=0.75
# Lokalny plik MTP (curl — subdirectories fail via HF download)
DRAFT_FLAG=-md
DRAFT_MODEL=/models/mtp-gemma-4-E2B-it-Q8_0.gguf
# Draft model on GPU (462 MB Q8_0 — zmieści się)
GPU_LAYERS_DRAFT=99
