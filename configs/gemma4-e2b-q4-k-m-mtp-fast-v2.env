# Gemma 4 E2B (5.1B) - Q4_K_M + multimodal + MTP [FAST v2]
# Uzycie: petla kamera->opis (niska latencja)
# v2: IMAGE_MAX_TOKENS=128, UBATCH=512, POLL=0, NO_HOST, MTMD_BATCH_MAX_TOKENS=256

# Model lokalny
MODEL_FLAG=-m
MODEL=/models/gemma-4-E2B-it-Q4_K_M.gguf

# Multimodal
MMPROJ_FLAG=--mmproj
MMPROJ=/models/mmproj-F16.gguf

# Bypass host buffer — wiecej VRAM dla GPU
NO_HOST=--no-host

# Batch dla enkodowania obrazu
MTMD_BATCH_MAX_TOKENS=256

# Image token limits — nizsze dla szybszego kodowania
IMAGE_MIN_TOKENS=66
IMAGE_MAX_TOKENS=128

# Wylaczone reasoning
REASONING=off

# Server
PORT=8089
HOST=0.0.0.0
CTX=16384
N_PREDICT=-1

NGLAYERS=999
CPUMOE=exps=CPU
FLASHATTN=on

BATCH=2048
UBATCH=512

THREADS=4
THREADS_BATCH=4
PARALLEL=1

# Poll=0 — CPU nie pollinguje, spi czekajac na GPU
POLL=0

CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
CACHE_RAM=512
CACHE_REUSE=256
CTX_CHECKPOINTS=2

# MTP — n_max=3 (dense model)
SPEC_TYPE=draft-mtp
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_N_MIN=1
SPEC_DRAFT_P_MIN=0.75
DRAFT_FLAG=-md
DRAFT_MODEL=/models/mtp-gemma-4-E2B-it-Q8_0.gguf
GPU_LAYERS_DRAFT=99
